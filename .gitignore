# OS
.DS_Store

# 예전 참고자료 백업 (앱 구동과 무관, 대용량)
backup/

# 임시 작업 폴더
scratchpad/

# 로컬 전용 도구 설정 (머신별 권한)
.claude/settings.local.json

# 시크릿
.env
.env.*

# 영상 제작 작업 폴더 (playwright/ffmpeg 산출물)
video/

# 내려받은 꾸러미 (npm install로 복구된다)
node_modules/

# 배포 도구
.vercel/

# ── 원본 자산 차단 ──────────────────────────────────────────
# 원본은 프로젝트 안에 들어오지 않는다. ~/Documents/Portfolio/_source/RM/ 에 둔다.
# 화면이 부르는 것은 경량본뿐이다 — 사진·일러스트=webp, 아이콘·로고=svg, 영상=mp4.
# 자세한 규칙: ../../CLAUDE.md
*.png
*.psd
*.ai
*.sketch
*.fig
*.mov
*.zip
*.tiff
*.tif
assets/**/*_origin/
assets/**/*-origin/
__pycache__/
